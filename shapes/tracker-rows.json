  },
  "vocab": {
    "state": [
      "waiting",
      "ready",
      "live",
      "hold",
      "skip",
      "open",
      "in review",
      "approved",
      "delivered",
      "closed"
    ],
    "status (attention list)": [
      "needs me",
      "waiting on them",
      "in progress",
      "done"
    ],
    "locked": [
      "yes",
      ""
    ]
  },
  "six_stage_tracker": {
    "where": "claude.ai artifact V36NdfcmgpeSxe1uYD1RdN, collection shots, one document per served folder",
    "stages": {
      "hull": "cleaned hull",
      "matte": "comp matte",
      "conv": "conversion",
      "stereo": "stereo comp",
      "test": "render test"
    },
    "status_values": [
      "Run",
      "Hold",
      "Skip"
    ]
  }
