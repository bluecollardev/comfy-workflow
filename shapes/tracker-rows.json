{
  "shape": "tracker-rows",
  "version": 1,
  "source": [
    "governance/policy/structure_v003.md §4 'Tracker fields'"
  ],
  "applies_to": "04_TRACKER/*.csv and the per-shot CSVs",
  "csv": {
    "04_TRACKER/shots.csv": [
