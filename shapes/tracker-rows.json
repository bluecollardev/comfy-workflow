      "received",
      "due",
      "state",
      "hero_eye",
      "locked",
      "next_action",
      "folder"
    ],
    "04_TRACKER/deliverables.csv": [
      "shot",
      "deliverable",
      "format",
      "spec",
      "due",
      "state",
      "version",
      "delivered_on"
    ],
    "04_TRACKER/schedule.csv": [
      "date",
      "milestone",
      "source",
      "note"
    ],
    "04_TRACKER/attention-list.csv": [
      "item",
      "kind",
      "from",
      "received",
      "due",
      "status",
      "inbox entry",
      "next action"
