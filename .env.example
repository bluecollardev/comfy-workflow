# RunPod Configuration
RUNPOD_API_KEY=your-runpod-api-key-here

# Optional: Custom RunPod endpoint (for self-hosted)
RUNPOD_BASE_URL=https://api.runpod.io

# Pod Configuration (optional - can also use CLI flags)
RUNPOD_POD_NAME=ComfyUI-Dev
RUNPOD_GPU_TYPE=rtx4090
RUNPOD_VOLUME_GB=50
RUNPOD_CONTAINER_DISK_GB=20
RUNPOD_IMAGE=ashleykza/runpod-comfyui:latest

# ComfyUI Configuration
COMFYUI_PORT=8188
COMFYUI_VRAM_OPTIMIZATION=1

# Project Configuration
PROJECT_NAME=comfy_workflow
ENVIRONMENT=development
