# ComfyUI outputs (local only, not shared)
outputs/*
!outputs/.gitkeep

# ComfyUI internal tracking (machine-specific)
.comfy/runs.jsonl
.comfy/assets.lock.json

# Models and datasets (too large)
assets/models/
assets/datasets/
*.ckpt
*.safetensors
*.pth
*.pt
*.bin

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# IDE (shared run configs stay: .vscode/{tasks,launch,settings}.json and .run/)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables (keep local)
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*.log
*.lock

# Compiled blueprints (auto-generated)
blueprints/*.compiled.json

# Docker build artifacts
docker/build/
docker/*.tar.gz
apps/runpod-dashboard/dist/
apps/runpod-dashboard/mcp/dist/
apps/runpod-dashboard/test-results/
apps/runpod-dashboard/playwright-report/
apps/runpod-dashboard/dist-electron/

# Local creative project files (large media, never commit). Only the README is tracked.
# Desktop-synced trees (CANALV2, ComfyUI-Shared) live in projects/desktop/.
# The ComfyUI install is apps/comfy-app/ (ignored by apps/comfy-app/.gitignore).
projects/*
!projects/README.md

# Panama exchange bucket credentials: never commit
docs/panama-*-aws.txt
