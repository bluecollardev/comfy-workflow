{
  "name": "runpod-pod-manager",
  "productName": "RunPod Manager",
  "version": "1.0.0",
  "description": "Desktop dashboard for RunPod GPU pods running ComfyUI (apps/runpod-dashboard)",
  "author": "Blue Collar Dev <info@bluecollardev.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run core:build && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icon": "node electron/make-icon.mjs",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder --mac --win --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "core:build": "tsc -p libs/core/tsconfig.json",
    "core:test": "vitest run --config libs/core/vitest.config.ts",
    "test": "npm run core:test",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "sass": "^1.105.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4",
    "@types/node": "^22.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.bluecollardev.runpod-manager",
    "productName": "RunPod Manager",
    "copyright": "Blue Collar Dev",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "libs/core/dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "../runpod-api",
        "to": "backend",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "../../shared/shapes/mount-points.json",
        "to": "backend/mount-points.json"
      },
      {
        "from": "../../shared/governance",
        "to": "backend/governance",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "libs/core/dist",
        "to": "core"
      },
      {
        "from": "build/build-info.json",
        "to": "build-info.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "maintainer": "Blue Collar Dev <info@bluecollardev.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
