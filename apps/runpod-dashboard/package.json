{
  "name": "runpod-pod-manager",
  "productName": "RunPod Manager",
  "version": "1.1.4",
  "description": "Desktop dashboard for RunPod GPU pods running ComfyUI (apps/runpod-dashboard)",
  "author": "Blue Collar Dev <info@bluecollardev.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run core:build && npm run mcp:bundle && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icon": "node electron/make-icon.mjs",
    "electron:dev": "npm run mcp:bundle && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder --mac --win --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "core:build": "tsc -p libs/core/tsconfig.json && node libs/core/mark-esm.mjs",
    "core:test": "vitest run --config libs/core/vitest.config.ts",
    "mcp": "node mcp/server.mjs",
    "mcp:bridge": "node mcp/comfy-bridge.mjs",
    "mcp:test": "npm run core:build && npm run mcp:bundle && node --test mcp/server.test.mjs mcp/comfy-bridge.test.mjs mcp/bundle.test.mjs mcp/host.test.mjs",
    "test": "npm run core:test && npm run mcp:test && npm run ipc:test",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "test:electron": "playwright test --config playwright.electron.config.js",
    "test:live": "RUNPOD_LIVE=1 playwright test --config playwright.electron.config.js live.spec.js",
    "cli": "node cli/index.mjs",
    "ipc:test": "node --test electron/core.test.mjs",
    "mcp:bundle": "esbuild mcp/server.mjs mcp/comfy-bridge.mjs --bundle --platform=node --format=cjs --target=node22 --define:__MCP_BUNDLE__=true --define:import.meta.url=undefined --log-level=warning --outdir=mcp/dist --out-extension:.js=.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.2",
    "codemirror": "^6.0.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "sass": "^1.105.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.bluecollardev.runpod-manager",
    "productName": "RunPod Manager",
    "copyright": "Blue Collar Dev",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "libs/core/dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "../../shared/shapes/mount-points.json",
        "to": "backend/mount-points.json"
      },
      {
        "from": "../../shared/governance",
        "to": "backend/governance",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "libs/core/dist",
        "to": "core"
      },
      {
        "from": "build/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "mcp/dist",
        "to": "mcp"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "maintainer": "Blue Collar Dev <info@bluecollardev.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
