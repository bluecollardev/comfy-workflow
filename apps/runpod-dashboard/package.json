{
  "name": "runpod-pod-manager",
  "productName": "RunPod Manager",
  "version": "1.0.0",
  "description": "Desktop dashboard for RunPod GPU pods running ComfyUI (apps/runpod-dashboard)",
  "author": "Blue Collar Dev <info@bluecollardev.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icon": "node electron/make-icon.mjs",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "vite build && electron-builder",
    "electron:pack": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "sass": "^1.105.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.bluecollardev.runpod-manager",
    "productName": "RunPod Manager",
    "copyright": "Blue Collar Dev",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      { "from": "dist", "to": "dist" },
      { "from": "../runpod-api", "to": "backend", "filter": ["*.py", "requirements.txt"] },
      { "from": "../../shared/shapes/mount-points.json", "to": "backend/mount-points.json" },
      { "from": "../../shared/governance", "to": "backend/governance", "filter": ["**/*.md"] }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "build/icon.png"
    },
    "dmg": {
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
