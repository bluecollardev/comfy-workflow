# Pinned sources for the ComfyUI server. Read by setup.sh, check.sh and build.sh.
# Keep in step with manifest.json / snapshots/ (what the desktop launcher installed).
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=3c1b7a17fdf239d35ce98cc777756f572d089795   # v0.39.2
PYTHON_VERSION=3.13
# The torch base images (docs/ADR-030): CUDA 12.6 for Hopper, Ampere and Ada; CUDA 13 for the Blackwell cards (sm_120 needs CUDA 12.8 or newer).
BASE_IMAGE_CU126=pytorch/pytorch:2.12.1-cuda12.6-cudnn9-runtime
BASE_IMAGE_CU13=pytorch/pytorch:2.12.1-cuda13.0-cudnn9-runtime
