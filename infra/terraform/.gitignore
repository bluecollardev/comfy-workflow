# Terraform state files (NEVER commit)
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*

# Terraform lock file (commit this to ensure reproducible builds)
# .terraform.lock.hcl - DO commit this

# Local .terraform directories
.terraform/
.terraform.lock.hcl

# Environment-specific tfvars (contain secrets)
terraform.tfvars
*.tfvars
!*.tfvars.example
!environments/*.tfvars.example

# Logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan
*.tfplan.*

# IDE
.idea/
*.swp
*.swo
*~
.DS_Store
