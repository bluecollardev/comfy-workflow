{
  "// One app: the Electron pod manager with its TypeScript core; no Python.": "",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: the app",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/runpod-dashboard",
      "runtimeExecutable": "${workspaceFolder}/apps/runpod-dashboard/node_modules/.bin/electron",
      "args": [
        "."
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Electron: the app with hot reload (run ./start.sh dashboard's Vite first)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/runpod-dashboard",
      "runtimeExecutable": "${workspaceFolder}/apps/runpod-dashboard/node_modules/.bin/electron",
      "args": [
        "."
      ],
      "env": {
        "VITE_DEV_SERVER_URL": "http://localhost:5173"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "MCP server (stdio)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/runpod-dashboard",
      "program": "${workspaceFolder}/apps/runpod-dashboard/mcp/server.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: pod list",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/runpod-dashboard",
      "program": "${workspaceFolder}/apps/runpod-dashboard/cli/index.mjs",
      "args": [
        "pod",
        "list"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "core tests (vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/runpod-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "core:test"
      ],
      "console": "integratedTerminal"
    }
  ]
}
